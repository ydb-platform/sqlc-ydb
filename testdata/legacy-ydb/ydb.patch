+		return nil, err
+	}
+	defer rows.Close()
+	var items []AuthorPagesRow
+	for rows.Next() {
+		var i AuthorPagesRow
+		if err := rows.Scan(&i.Author, &i.NumBooks, &i.TotalPages); err != nil {
+			return nil, err
+		}
+		items = append(items, i)
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
