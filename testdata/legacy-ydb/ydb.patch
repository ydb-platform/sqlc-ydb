+	Count uint64 `json:"count"`
+}
+
+func (q *Queries) VenueCountByCity(ctx context.Context, opts ...query.ExecuteOption) ([]VenueCountByCityRow, error) {
+	result, err := q.db.QueryResultSet(ctx, venueCountByCity, opts...)
+	if err != nil {
