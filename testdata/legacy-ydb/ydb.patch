+	} else if b := n.Bind_parameter(); b != nil {
+		param, ok := b.Accept(c).(ast.Node)
+		if !ok {
+			return todo("VisitType_name_or_bind", b)
+		}
+		// FIXME: this is not working right now for type definitions
+		return &ast.TypeName{
+			Names: &ast.List{
