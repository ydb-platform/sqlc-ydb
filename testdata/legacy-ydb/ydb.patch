+		return &ast.A_Expr{
+			Name:     &ast.List{Items: []ast.Node{&ast.String{Str: op}}},
+			Lexpr:    operand,
+			Location: c.pos(n.GetStart()),
+		}
+	}
+
+	operand, ok := n.Unary_subexpr().Accept(c).(ast.Node)
+	if !ok {
+		return todo("VisitCon_subexpr", n.Unary_subexpr())
+	}
+	return operand
