+			return nil, xerrors.WithStackTrace(err)
+		}
+		var i Venue
+		if err := row.Scan(
+			&i.ID,
+			&i.Status,
+			&i.Slug,
+			&i.Name,
+			&i.City,
+			&i.SpotifyPlaylist,
+			&i.SongkickID,
+			&i.Tags,
+			&i.CreatedAt,
+		); err != nil {
