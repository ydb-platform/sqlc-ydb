<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>example.com.sqlc-ydb-authors</groupId>
    <artifactId>authors-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>sqlc-ydb authors Java examples</name>

    <modules>
        <module>native</module>
        <module>jdbc</module>
        <module>spring</module>
        <module>hibernate</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <ydb.sdk.version>2.4.11</ydb.sdk.version>
        <ydb.jdbc.version>2.4.1</ydb.jdbc.version>

        <spring.boot.version>4.0.3</spring.boot.version>
        <spring.jdbc.ydb.dialect.version>1.2.2</spring.jdbc.ydb.dialect.version>

        <hibernate.version>6.2.7.Final</hibernate.version>
        <hibernate.ydb.dialect.version>1.7.1</hibernate.ydb.dialect.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tech.ydb</groupId>
                <artifactId>ydb-sdk-bom</artifactId>
                <version>${ydb.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
