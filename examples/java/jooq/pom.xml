<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>tech.ydb.sqlc.examples</groupId>
  <artifactId>jooq-examples</artifactId>
  <version>1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency><groupId>org.jooq</groupId><artifactId>jooq</artifactId><version>3.21.0</version></dependency>
    <dependency><groupId>tech.ydb.dialects</groupId><artifactId>jooq-ydb-dialect</artifactId><version>2.0.0</version></dependency>
    <dependency><groupId>tech.ydb.jdbc</groupId><artifactId>ydb-jdbc-driver</artifactId><version>2.4.1</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.14.3</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.5</version></plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions><execution><id>generated-examples</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
          <configuration><sources>
            <source>${project.basedir}/../../authors/java/jooq</source>
            <source>${project.basedir}/../../batch/java/jooq</source>
            <source>${project.basedir}/../../booktest/java/jooq</source>
            <source>${project.basedir}/../../jets/java/jooq</source>
            <source>${project.basedir}/../../ondeck/java/jooq</source>
          </sources></configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
